(module
  (func (export "i32_ops") (param $a i32) (param $b i32) (result i32)
    (i32.xor
      (i32.rotl (i32.add (local.get $a) (local.get $b)) (i32.const 5))
      (i32.or (i32.and (local.get $a) (i32.const 0xFF00)) (i32.shl (local.get $b) (i32.const 3)))))
  (func (export "clz") (param i32) (result i32) (i32.clz (local.get 0)))
  (func (export "ctz") (param i32) (result i32) (i32.ctz (local.get 0)))
  (func (export "popcnt") (param i64) (result i64) (i64.popcnt (local.get 0)))
  (func (export "div_s") (param i32 i32) (result i32) (i32.div_s (local.get 0) (local.get 1)))
  (func (export "rem_s") (param i32 i32) (result i32) (i32.rem_s (local.get 0) (local.get 1)))
  (func (export "div_u") (param i32 i32) (result i32) (i32.div_u (local.get 0) (local.get 1)))
  (func (export "i64_mul") (param i64 i64) (result i64) (i64.mul (local.get 0) (local.get 1)))
  (func (export "shr_s64") (param i64 i64) (result i64) (i64.shr_s (local.get 0) (local.get 1)))
  (func (export "f64_ops") (param f64 f64) (result f64)
    (f64.add (f64.mul (local.get 0) (local.get 1)) (f64.sqrt (f64.abs (local.get 0)))))
  (func (export "f32_ops") (param f32 f32) (result f32)
    (f32.div (f32.sub (local.get 0) (local.get 1)) (f32.const 3)))
  (func (export "fmin") (param f64 f64) (result f64) (f64.min (local.get 0) (local.get 1)))
  (func (export "fmax") (param f64 f64) (result f64) (f64.max (local.get 0) (local.get 1)))
  (func (export "nearest") (param f64) (result f64) (f64.nearest (local.get 0)))
  (func (export "trunc_s") (param f64) (result i32) (i32.trunc_f64_s (local.get 0)))
  (func (export "trunc_sat_s") (param f64) (result i32) (i32.trunc_sat_f64_s (local.get 0)))
  (func (export "trunc_sat_u64") (param f32) (result i64) (i64.trunc_sat_f32_u (local.get 0)))
  (func (export "convert_u") (param i32) (result f32) (f32.convert_i32_u (local.get 0)))
  (func (export "convert_u64") (param i64) (result f64) (f64.convert_i64_u (local.get 0)))
  (func (export "demote") (param f64) (result f32) (f32.demote_f64 (local.get 0)))
  (func (export "promote") (param f32) (result f64) (f64.promote_f32 (local.get 0)))
  (func (export "reinterpret") (param f32) (result i32) (i32.reinterpret_f32 (local.get 0)))
  (func (export "wrap") (param i64) (result i32) (i32.wrap_i64 (local.get 0)))
  (func (export "extend_s") (param i32) (result i64) (i64.extend_i32_s (local.get 0)))
  (func (export "extend8") (param i32) (result i32) (i32.extend8_s (local.get 0)))
  (func (export "copysign") (param f64 f64) (result f64) (f64.copysign (local.get 0) (local.get 1)))
  (func (export "consts") (result f64)
    (f64.add (f64.const 0x1.8p1) (f64.add (f64.const 1e3) (f64.const -0.5))))
  (func (export "f32_consts") (result f32)
    (f32.add (f32.const 0x1p-2) (f32.const 1_000.25)))
  (func (export "nan") (result f32) (f32.const nan))
  (func (export "inf") (result f64) (f64.const -inf))
  (func (export "nan_payload") (result f64) (f64.const nan:0x4_0000_0000_0001))
  (func (export "int_consts") (result i64)
    (i64.add (i64.const 0xFFFF_FFFF_FFFF_FFFF) (i64.const -1_000)))
  (func (export "u32_max") (result i32) (i32.const 4294967295))
  (func (export "lt") (param f64 f64) (result i32) (f64.lt (local.get 0) (local.get 1))))
