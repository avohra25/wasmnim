(module
  (memory (export "mem") 1 4)
  (data (i32.const 16) "hello, wasm")
  (data (i32.const 64) "\01\02\03\04\ff\00")
  (func (export "load8") (param $p i32) (result i32)
    (i32.load8_u (local.get $p)))
  (func (export "load8s") (param $p i32) (result i32)
    (i32.load8_s (local.get $p)))
  (func (export "load_off") (param $p i32) (result i32)
    (i32.load offset=16 align=1 (local.get $p)))
  (func (export "store32") (param $p i32) (param $v i32)
    (i32.store (local.get $p) (local.get $v)))
  (func (export "store64") (param $p i32) (param $v i64)
    (i64.store offset=8 (local.get $p) (local.get $v)))
  (func (export "load64") (param $p i32) (result i64)
    (i64.load offset=8 (local.get $p)))
  (func (export "loadf64") (param $p i32) (result f64)
    (f64.load (local.get $p)))
  (func (export "storef32") (param $p i32) (param $v f32)
    (f32.store (local.get $p) (local.get $v)))
  (func (export "size") (result i32) (memory.size))
  (func (export "grow") (param $n i32) (result i32) (memory.grow (local.get $n)))
  (func (export "fill") (param $d i32) (param $v i32) (param $n i32)
    (memory.fill (local.get $d) (local.get $v) (local.get $n)))
  (func (export "copy") (param $d i32) (param $s i32) (param $n i32)
    (memory.copy (local.get $d) (local.get $s) (local.get $n)))
  (func (export "sum") (param $p i32) (param $n i32) (result i32)
    (local $s i32)
    (block $out
      (loop $l
        (br_if $out (i32.eqz (local.get $n)))
        (local.set $s (i32.add (local.get $s) (i32.load8_u (local.get $p))))
        (local.set $p (i32.add (local.get $p) (i32.const 1)))
        (local.set $n (i32.sub (local.get $n) (i32.const 1)))
        (br $l)))
    (local.get $s)))
